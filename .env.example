# ============================================================
# ONSV - Variables de entorno (plantilla)
# Copia este archivo a `.env` y completa los valores REALES.
# NUNCA subas `.env` ni claves a git / GCP.
# ============================================================

# --- Modo de despliegue ---
# GCP        -> usa Firestore + Cloud Storage (estrategia cloud)
# ON_PREMISE -> usa MySQL local (estrategia on-premise)
STRATEGY_MODE=ON_PREMISE

# --- Puerto del servidor ---
PORT=3000

# --- Base de datos MySQL (ON_PREMISE) ---
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=cambia_esta_clave
DATABASE_NAME=onsv

# --- Firestore / Cloud Storage (GCP) ---
SERVICE_ACCOUNT_GCP=./utils/keys/mi-service-account.json
PROJECT_ID=mi-proyecto-gcp

# --- Clave de cifrado de passwords ---
# IMPORTANTE: usa bcrypt. Esta clave SOLO se usa para migrar hashes
# antiguos (AES). Debe tener > 16 caracteres.
CRYPTO_SECRET_KEY=cambia_esta_clave_de_cifrado

# --- Secreto de sesión (FORTALEZA: minimo 32 caracteres) ---
SECRET_APPLICATION=cambia_este_secreto_min_32_caracteres_abc123

# --- Identidad de sesión (sufijo para ofuscar el id de usuario) ---
DATA_TO_CRYPT=alguna_cadena_aleatoria

# --- Ghost CMS (Content API) ---
GHOST_URL=https://www.onsv.gob.pe:5000
GHOST_CONTENT_KEY=cambia_la_key_de_ghost

# --- Mailchimp ---
API_KEY_MAIL_CHIMP=cambia_la_key_de_mailchimp
ONSV_ID_AUDIENCE=cambia_el_id_de_audiencia

# --- YouTube ---
YOUTUBE_API_KEY=cambia_la_key_de_youtube
ID_PLAYLIST_YOUTUBE_DEV=cambia_el_id_de_playlist_dev
ID_CHANNEL_YOUTUBE_PROD=cambia_el_id_de_canal

# --- Campañas / Correo ---
EMAIL_CAMPAIGN=no-reply@onsv.gob.pe

# --- Webhook ORV (Google Apps Script) ---
GAS_ORV_WEBHOOK_URL=https://script.google.com/macros/s/cambia/exec

# --- Tablas / rutas (uso interno) ---
USER_TABLE=users
DOCUMENTS_TABLE=metadata
PROTOCOL_HTTP=http
URL_PATH=http://localhost:3000
URL_PATH_API=http://localhost:3000
URL_PATH_API2=http://localhost:3000
URL_PATH_API3=http://localhost:3000
URL_PATH_FILES=http://localhost:3000


# CREDENCIALES FTP - DATOS ABIERTOS MTC (Pendientes de entrega)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=false
FTP_REMOTE_DIR=
FTP_PUBLIC_URL=
