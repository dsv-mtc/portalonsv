<!DOCTYPE html>
<html lang="{{lang}}">

  <head>
    {{> seo/head}}
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-256137196-1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'UA-256137196-1');
    </script>
  </head>

	<body>
		<div id="fb-root"></div>
		{{#if enabledNavigation}}
			{{> default/navigation}}
		{{/if}}

		{{{body}}}
		
		{{#if enabledFooter}}
			{{> default/footer}}
		{{/if}}
		
		{{#if enabledNavigation}}
			{{> default/suscribers-modal}}
		{{/if}}
		
		<script>
			window.fbAsyncInit = function () {
				FB.init({
					xfbml: true,
					version: 'v19.0'
				});
				if (document.querySelector('.fb-page')) {
					FB.XFBML.parse();
				}
			};
			(function (d, s, id) {
				var js, fjs = d.getElementsByTagName(s)[0];
				if (d.getElementById(id)) { return; }
				js = d.createElement(s); js.id = id;
				js.src = 'https://connect.facebook.net/es_LA/sdk.js';
				fjs.parentNode.insertBefore(js, fjs);
			}(document, 'script', 'facebook-jssdk'));
		</script>
		<script src="/main.js"></script>
		<script src="/opendata.js"></script>
		<script src="/features.js"></script>

		
	</body>

</html>
