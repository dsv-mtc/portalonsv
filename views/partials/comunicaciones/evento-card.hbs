<article class="nxt-event-card">
  <a class="nxt-card-body" href="/comunicaciones/{{id}}">
    
    <div class="nxt-date">
      <span class="nxt-day">{{startDay}}</span>
      <span class="nxt-month">{{startMonth}}</span>
    </div>

    <div class="nxt-info">
      <h6 class="nxt-title">{{title}}</h6>
      <div class="nxt-desc">
        {{{shortDescription}}}
      </div>
    </div>

  </a>
</article>