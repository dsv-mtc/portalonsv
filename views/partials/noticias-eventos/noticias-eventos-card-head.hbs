<div class="col-md-6 pb-5">
    <div class="rsp-res-img">
        <div class="card-badge">{{parseRegion tags}}</div>
        <a href="{{endpointPostParse (parseHttp url) lang}}">
            <img class="noticias-p-img" src="{{parseHttpImage feature_image}}" alt="imagen">
        </a>
    </div>
</div>
<div class="col-md-6 pb-5 noticias-text-offset">
    <span class="noticias-featured-label">{{t lang "Destacada"}}</span>
    <div class="rsp-res-blk rsp-nye-desc">
        <a href="{{ endpointPostParse (parseHttp url) lang }}">
            <h6 class="ft-bold"><a href="{{ endpointPostParse (parseHttp url) lang  }}">{{ title}}</h6>
        </a>
    </div>
    <div class="rsp-pro-det">
    <div class="pd-desc noticias-pd-desc">
        <div class="cl"><i class="fas fa-calendar-alt"></i> {{parseDate created_at }} </div>
    </div>
</div>
    <p class="noticias-excerpt-offset">
    {{excerpt}}
</p>
    <div class="nye-link-blk">
        <div class="ny-btn">
            <a href="{{endpointPostParse (parseHttp url) lang}}" class="btn btn-rsp ft-bold">
                {{t lang "leer más"}} <i class="fal fa-long-arrow-right pl-2"></i>
            </a>
        </div>
        <div class="ny-link">
            <ul class="so-links">
                <li>
                    <a href="{{@root.popupSocial.facebook}}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                </li>
                <li>
                    <a href="{{@root.popupSocial.twitter}}" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                </li>
                <li>
                    <a href="#" role="button" class="share-card-btn" data-url="{{url}}" data-title="{{title}}" aria-label="Compartir"><i class="fas fa-share-alt"></i></a>
                </li>
            </ul>
        </div>
    </div>
</div>