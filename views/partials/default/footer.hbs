<style>
  .site-footer { background: var(--navy); color: #aeb9d2; padding: 60px 0 20px; font-family: "Barlow", sans-serif; }
  
  .site-footer .ft-title { color: #fff; font-family: "Barlow Condensed", sans-serif; font-size: 20px; text-transform: uppercase; font-weight: 700; margin-bottom: 22px; letter-spacing: .02em; }
  
  .site-footer .brand-col .b-bold { font-weight: 700; font-family: "Barlow Condensed", sans-serif; font-size: 22px; color: #fff; text-transform: uppercase; line-height: 1.1; margin-bottom: 16px; }
  .site-footer .brand-col .b-light { font-size: 15px; line-height: 1.5; color: #aeb9d2; margin: 0; }
  
  .site-footer .link-list { list-style: none; padding: 0; margin: 0; }
  .site-footer .link-list li { margin-bottom: 14px; }
  .site-footer .link-list a { color: #fff; text-decoration: none; transition: .2s; font-size: 15px; display: inline-block; }
  .site-footer .link-list a:hover { color: var(--red); transform: translateX(5px); }
  
  .site-footer .ft-list { list-style: none; padding: 0; margin: 0; }
  .site-footer .ft-list li { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; font-size: 14px; line-height: 1.4; }
  .site-footer .ft-list li i { color: var(--red); font-size: 16px; margin-top: 2px; width: 16px; text-align: center; }
  .site-footer .ft-list li span { display: block; color: #fff; font-weight: 500; font-size: 15px; }
  .site-footer .ft-list a { color: #fff; text-decoration: none; transition: 0.2s; }
  .site-footer .ft-list a:hover { color: var(--red); }
  
  .site-footer .footer-social-row { margin-top: 30px; margin-bottom: 24px; }
  .site-footer .cp-area { border-top: 1px solid rgba(255,255,255,0.1); margin-top: 0; padding-top: 24px; font-size: 14px; color: #8a96b3; font-family: "Barlow", sans-serif; }
  .site-footer .cp-flex { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  
  .site-footer .legal-links { display: flex; gap: 20px; flex-wrap: wrap; }
  .site-footer .legal-links a { color: #8a96b3; text-decoration: none; transition: 0.2s; display: flex; align-items: center; }
  .site-footer .legal-links a:hover { color: #fff; }
  .site-footer .badge-new { background: var(--amber); color: var(--navy); font-size: 10px; font-family: "Barlow Semi Condensed", sans-serif; padding: 2px 6px; border-radius: 4px; font-weight: 700; text-transform: uppercase; margin-left: 8px; letter-spacing: 0.05em; }

  @media (min-width: 992px) {
    .espacio-inst { padding-left: 50px; }
    .espacio-secc { padding-left: 50px; }
    .espacio-cont { padding-left: 30px; }
  }
</style>

<footer class="site-footer" id="footer">
  <div class="container">
    <div class="row">
      
      <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 brand-col">
        <h4 class="b-bold">{{t lang "Observatorio Nacional de Seguridad Vial"}}</h4>
        <p class="b-light">{{footerData.descripcion}}</p>
      </div>

      <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 espacio-inst">
        <h4 class="ft-title">{{t lang "Institución"}}</h4>
        <ul class="link-list">
          <li><a href="/nosotros">{{t lang "Quiénes somos"}}</a></li>
          <li><a href="/nosotros#mision">{{t lang "Misión y visión"}}</a></li>
          <li><a href="#tech">{{t lang "Componentes tecnológicos"}}</a></li>
        </ul>
      </div>

      <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 espacio-secc">
        <h4 class="ft-title">{{t lang "Secciones"}}</h4>
        <ul class="link-list">
          {{#each footerData.secciones}}
          <li><a href="{{enlace}}">{{titulo}}</a></li>
        {{else}}
          <li><a href="/publicaciones">{{t lang "Publicaciones"}}</a></li>
          <li><a href="/datosabiertos">{{t lang "Datos abiertos"}}</a></li>
          <li><a href="/normas-legales">{{t lang "Normas legales"}}</a></li>
        {{/each}}
        </ul>
      </div>

      <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 espacio-cont">
        <h4 class="ft-title">{{t lang "Contacto"}}</h4>
        <ul class="ft-list">
          <li>
            <i class="fas fa-map-marker-alt"></i>
            <div>
              <span>{{footerData.direccion}}</span>
            </div>
          </li>
          <li>
            <i class="fas fa-phone"></i>
            <div>
              <span><a href="tel:{{footerData.telefono}}">{{footerData.telefono}}</a></span>
            </div>
          </li>
          <li>
            <i class="fas fa-envelope"></i>
            <div>
              <span><a href="mailto:{{footerData.email}}">{{footerData.email}}</a></span>
            </div>
          </li>
          <li>
            <i class="fas fa-clock"></i>
            <div>
              <span>{{footerData.horario}}</span>
            </div>
          </li>
        </ul>
      </div>

    </div>

    {{#if footerData.redesSociales.length}}
    <div class="row footer-social-row">
      <div class="col-12">
        <div class="d-flex justify-content-end flex-wrap" style="gap: 10px;">
          {{#each footerData.redesSociales}}
            {{#if isActive}}
            <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="d-inline-flex align-items-center gap-2"
               style="color:#fff;text-decoration:none;font-weight:600;font-size:14px;padding:8px 16px;border-radius:10px;transition:0.2s;background:rgba(255,255,255,0.06);"
               onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
              {{#if imagen_url}}
                <img src="{{imagen_url}}" alt="{{red}}" style="width:20px;height:20px;object-fit:contain;border-radius:4px;">
              {{else}}
                <i class="fab fa-{{lower red}}"></i>
              {{/if}}
            </a>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}

    <div class="row">
      <div class="col-12">
        <div class="cp-area">
          <div class="cp-flex">
            <div>
              &copy; {{t lang "Observatorio Nacional de Seguridad Vial"}} &mdash; MTC
            </div>
            
            
          </div>
        </div>
      </div>
    </div>
    
  </div>
</footer>
