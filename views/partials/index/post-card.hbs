<div class="col-lg-4 col-md-6 mb-4">
  <article class="rsp-res-blk new-card">
    
    <div class="card-badge">{{#if primary_tag.name}}{{primary_tag.name}}{{else}}Informe{{/if}}</div>
    
    <a href="{{endpointPostParse (parseHttp url) lang }}" class="m-gap">
      <img class="pu-3-extend card-img" src="{{parseHttpImage feature_image }}" alt="Publicación">
    </a>
    
    <div class="card-content">
      <div class="card-meta">
        <span>
          <i class="fal fa-calendar-alt"></i> 
          {{parseDate published_at }}
        </span>
      </div>
      
      <p class="p-hide">
        {{excerpt }}
      </p>
      
      <a href="{{endpointPostParse (parseHttp url) lang }}" class="card-link">
        Descargar PDF &rarr;
      </a>
    </div>

  </article>
</div>