<style>
  .new-card { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .new-card:hover { transform: translateY(-6px); box-shadow: 0 15px 35px rgba(20,33,61,.15); }
  
  .new-card .card-badge { position: absolute; top: 12px; left: 12px; background: #ffffff; color: var(--navy); font-family: "Barlow Semi Condensed", sans-serif; font-weight: bold; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; padding: 5px 10px; border-radius: 6px; z-index: 2; box-shadow: 0 4px 10px rgba(0,0,0,0.15); }
  
  .new-card .card-img { width: 100%; height: 200px; object-fit: cover; border-bottom: 1px solid var(--line); }
  
  .new-card .card-content { padding: 16px 20px 20px; display: flex; flex-direction: column; flex: 1; text-align: left; }
  
  .new-card .card-cat { font-family: "Barlow Semi Condensed", sans-serif; font-weight: bold; font-size: 12px; color: var(--navy); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; display: block; }
  
  .new-card .card-title { font-family: "Barlow Condensed", sans-serif; font-weight: 800 !important; font-size: 20px; color: var(--navy); line-height: 1.25; margin: 0 0 8px 0; padding: 0; letter-spacing: -0.01em; }
  
  .new-card .p-hide { margin: 0 0 14px 0 !important; padding: 0 !important; text-indent: 0 !important; flex: 1; color: #64748b; font-family: "Barlow", sans-serif; font-size: 13.5px; line-height: 1.4; text-align: left; }
  
  .new-card .card-link { font-family: "Barlow Semi Condensed", sans-serif; font-weight: bold; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--red); display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: 0.2s; margin-top: auto; align-self: flex-start; }
  .new-card .card-link:hover { color: var(--navy); gap: 10px; text-decoration: none; }
</style>

<div class="col-lg-4 col-md-6 mb-4">
  <div class="rsp-res-blk new-card">
    
    <div class="card-badge">{{#if primary_tag.name}}{{primary_tag.name}}{{else}}Puno{{/if}}</div>
    
    <a href="{{endpointPostParse (parseHttp url) lang }}">
      <img class="no-6 card-img" src="{{parseHttpImage feature_image}}" alt="{{title}}">
    </a>
    
    <div class="card-content">
      <span class="card-cat">Regiones</span>
      
      <h3 class="card-title">{{title}}</h3>
      
      <p class="p-hide">{{ excerpt }}</p>
      
      <a href="{{endpointPostParse (parseHttp url) lang }}" class="card-link">
        Leer noticia &rarr;
      </a>
    </div>

  </div>
</div>