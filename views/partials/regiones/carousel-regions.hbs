{{#each post}}
    <div class="item">
        <div class="rsp-res-blk new-card">
            <a href="{{endpointPostParse (parseHttp url) ../lang}}">
                <img class="card-img" src="{{parseHttpImage feature_image}}" alt="{{title}}">
            </a>
            <div class="card-content">
                <span class="card-meta"><i class="fas fa-calendar-alt"></i> {{parseDate created_at}}</span>
                <h3 class="card-title">{{title}}</h3>
                <a href="{{endpointPostParse (parseHttp url) ../lang}}" class="card-link">
                    {{t ../lang "leer más"}} &rarr;
                </a>
            </div>
        </div>
    </div>
{{/each}}
