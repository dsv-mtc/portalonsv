{{#if datosAbiertos}}
  {{#each datosAbiertos}}
    <div class="od-card fx-hide">
      
      <div class="od-card-header">
        <span class="od-date">PUBLICADO EL {{fecha}}</span>
        <span class="od-category-pill">• {{categoria}}</span>
      </div>

      <h3 class="od-title">{{titulo}}</h3>
      
      <p class="od-desc">{{descripcion}}</p>

      <div class="od-meta">
        {{t lang "Autor"}}: {{autor}} • {{t lang "Tipo"}}: Dataset
      </div>
      
      <div class="od-links">
        
        <a href="{{excelfile}}" download class="od-link-btn od-excel {{#if hasExcel}}not_null{{else}}is_null{{/if}}">
