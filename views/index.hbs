<script>
  document.addEventListener("DOMContentLoaded", function() {
      const baselines = { 
          'var-accidentados': 86757, 
          'var-lesionados': 56747, 
          'var-fallecidos': 3002 
      };

      document.querySelectorAll('.stats-variation').forEach(el => {
          const numEl = document.getElementById(el.id.replace('var-', 'val-'));
          const currentVal = parseInt(numEl.innerText.replace(/[^0-9]/g, ''));
          const baseVal = baselines[el.id];

          if (currentVal && baseVal) {
              const diff = ((currentVal - baseVal) / baseVal) * 100;
              const sign = diff >= 0 ? '+' : '';
              el.innerHTML = `2025 · Fuente PNP · <span class="red-text">${sign}${diff.toFixed(1)}% vs 2024</span>`;
          }
      });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const nums = document.querySelectorAll(".kpi .num");

    function animateCount(el) {
      const raw = el.innerText.replace(/[^0-9]/g, "");
      if (!raw) return;
      const target = parseInt(raw);
      if (el.dataset.counted === "true") return;
      el.dataset.counted = "true";

      const duration = 2000;
      const start = performance.now();

      function tick(now) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
        el.innerText = Math.round(target * eased).toLocaleString();
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    nums.forEach(num => observer.observe(num));
  });
</script>

