<script>
  document.addEventListener("DOMContentLoaded", function () {
    var el = document.getElementById("heroCarousel");
    var capsules = document.querySelectorAll(".hero-capsule");
    var slides = el.querySelectorAll(".carousel-item");
    var current = 0;
    var timer;

    function goTo(index) {
      slides[current].classList.remove("active");
      capsules[current].classList.remove("active");
      current = index;
      slides[current].classList.add("active");
      capsules[current].classList.add("active");
      restartFill();
    }

    function next() { goTo((current + 1) % slides.length); }

    function restartFill() {
      var fill = capsules[current].querySelector(".capsule-fill");
      if (fill) {
        fill.style.animation = "none";
        void fill.offsetWidth;
        fill.style.animation = "";
      }
    }

    capsules.forEach(function (cap, i) {
      cap.addEventListener("click", function () { goTo(i); });
    });

    timer = setInterval(next, 5000);
  });
</script>

