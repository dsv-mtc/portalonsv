<script>
  document.addEventListener("DOMContentLoaded", function () {
    var scCard = document.querySelector(".social-sec .sc-card");
    if (!scCard) return;

    var tabs = scCard.querySelectorAll(".sc-tab");
    var panels = scCard.querySelectorAll(".sc-panel");
    var nameEl = document.getElementById("scNetworkName");
    var handleEl = document.getElementById("scNetworkHandle");
    var footerLink = document.getElementById("scFooterLink");
    var footerBtn = document.getElementById("scFooterBtn");

    var redes = {
      fb: {
        nombre: "FACEBOOK",
        handle: "@ObservatorioNSV",
        url: "https://www.facebook.com/onsvPE/"
      },
      x: {
        nombre: "X (TWITTER)",
        handle: "@onsvPE",
        url: "https://x.com/onsvPE"
      }
    };

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        var destino = tab.getAttribute("data-panel");

        tabs.forEach(function (t) { t.classList.remove("active"); });
        tab.classList.add("active");

        panels.forEach(function (panel) {
          panel.style.display = panel.getAttribute("data-panel") === destino ? "" : "none";
        });

        var data = redes[destino];
        if (data) {
          if (nameEl) nameEl.textContent = data.nombre;
          if (handleEl) handleEl.textContent = data.handle;
          if (footerLink) footerLink.href = data.url;
          if (footerBtn) {
            footerBtn.classList.toggle("x", destino === "x");
            footerBtn.href = data.url;
            footerBtn.textContent = destino === "x" ? "VER PERFIL EN X" : "VER PERFIL EN FB";
          }
        }
      });
    });

    var ytCard = document.querySelector(".social-sec .col-lg-8 .sc-card");
    var ytItems = ytCard.querySelectorAll(".yt-item");
    var ytTitle = ytCard.querySelector(".yt-title");
    ytItems.forEach(function (item) {
      item.addEventListener("click", function () {
        ytItems.forEach(function (i) { i.classList.remove("active"); });
        this.classList.add("active");
        var titleEl = this.querySelector(".title");
        if (titleEl && ytTitle) {
          ytTitle.textContent = titleEl.textContent;
        }
      });
    });
  });
</script>

