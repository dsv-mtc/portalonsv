<script>
  document.addEventListener("DOMContentLoaded", function () {
    var mesesCortos = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];

    function formatearHoraCorta(texto) {
      var partes = texto.trim().split(":");
      if (partes.length >= 2) {
        return partes[0] + ":" + partes[1];
      }
      return texto;
    }

    function formatearFechaCorta(texto) {
      var partes = texto.trim().split(/[-\/]/);
      if (partes.length !== 3) return texto;

      var dia, mesIndex;
      if (partes[0].length === 4) {
        mesIndex = parseInt(partes[1], 10) - 1;
        dia = partes[2];
      } else {
        dia = partes[0];
        mesIndex = parseInt(partes[1], 10) - 1;
      }

      if (mesesCortos[mesIndex]) {
        return dia.padStart(2, "0") + " " + mesesCortos[mesIndex];
      }
      return texto;
    }

    document.querySelectorAll(".accident-row").forEach(function (fila) {
      var horaEl = fila.querySelector(".ar-time");
      var fechaEl = fila.querySelector(".ar-day");
      if (horaEl) horaEl.textContent = formatearHoraCorta(horaEl.textContent);
      if (fechaEl) fechaEl.textContent = formatearFechaCorta(fechaEl.textContent);
    });
  });
</script>

