<section class="container" style="padding-top: 40px; padding-bottom: 20px;">
  <div class="events-main-title">
    <h1>INFORMACIÓN DE DATOS ABIERTOS</h1>
  </div>
</section>

<section class="open_data container">
  <form id="open-data-form-search" class="od-search-form">
    <div class="od-search-grid">
      
      <div class="od-input-group od-col-desc">
        <label for="descripcion">DESCRIPCIÓN</label>
        <input type="text" id="descripcion" name="descripcion" placeholder="{{t lang 'Buscar aquí...'}}">
      </div>

      <div class="od-input-group od-col-cat">
        <label for="categoria">CATEGORÍA</label>
        <select name="categoria" id="categoria">
          <option selected value="Todas">Todas</option>
          {{#each categorias}}
            <option value="{{id}}">{{value}}</option>
          {{/each}}
        </select>
      </div>

      <div class="od-input-group od-col-tipo">
        <label for="tipo">TIPO</label>
        <select name="tipo" id="tipo">
          <option selected value="Todos">Todos</option>
          {{#each tipos}}
            <option value="{{id}}">{{value}}</option>
          {{/each}}
        </select>
      </div>

      <div class="od-input-group od-col-actions">
        <button type="submit" class="od-btn-submit">CONSULTAR</button>
        <button type="button" id="clean-search" class="od-btn-clean">LIMPIAR</button>
      </div>

    </div>
  </form>
    
  <div id="open-data-search-alert" class="alert alert-danger alert-dismissible fade d-none mt-3" role="alert">
    {{t lang "No se encontraron resultados"}}
  </div>
</section>

<main class="container" style="padding-bottom: 60px;">
  <section id="default">
    
    <h3 class="od-results-msg">
      {{message}}
    </h3>
    
    <div class="od-cards-container">
      {{>datos-abiertos/datos-abiertos-card-body datosAbiertos=datosAbiertos}}
    </div>
    
    <style>
      .custom-pag-wrapper {
        gap: 8px;
      }
      .custom-pag-btn {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 17px;
        border: 1px solid transparent;
        background: transparent;
        color: #1d3557;
        transition: all 0.3s ease;
        text-decoration: none;
        cursor: pointer;
      }
      .custom-pag-btn:hover {
        background-color: transparent;
        color: #C8102E;
        border: 1px solid #C8102E;
      }
      .custom-pag-btn.active {
        background-color: #C8102E;
        color: white;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      }
      .custom-pag-btn.active:hover {
        background-color: #C8102E;
        color: white;
        border: 1px solid transparent;
      }
      .custom-pag-btn i {
        font-size: 20px;
      }
    </style>

    {{#if pagination}}
      <nav class="col-12 d-flex justify-content-center align-items-center mt-5 mb-4 custom-pag-wrapper">
        {{#each pagination.pages_list}}
          {{#if (eq this '...')}}
            <span class="custom-pag-btn" style="cursor:default;border:none;">…</span>
          {{else}}
            <a href="{{page_url ../pagination.url_page this ../lang}}" class="custom-pag-btn{{#if (eq this ../pagination.page)}} active{{/if}}" aria-label="Página {{this}}">{{this}}</a>
          {{/if}}
        {{/each}}
        {{#if pagination.next}}
          <a href="{{page_url pagination.url_page pagination.next lang}}" class="custom-pag-btn" aria-label="Siguiente página">
            <i class="fal fa-chevron-right"></i>
          </a>
        {{/if}}
        <a href="{{page_url pagination.url_page pagination.pages lang}}" class="custom-pag-btn" aria-label="Última página">
          <i class="fal fa-chevron-double-right"></i>
        </a>
      </nav>
    {{/if}}

  </section>

  <section id="results-template"></section>
</main>