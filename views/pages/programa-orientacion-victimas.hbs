<script>
(function () {
  "use strict";

  // AFOCAT dataset (same as original repo)
  var afocatData = [
    { nombre: "AFOCAT CHIMBOTE REGION ANCASH", link: "https://www.afocatchimboteancash.org/", region: "ANCASH" },
    { nombre: "AFORCAT - ANCASH", link: "https://www.aforcatancash.com/", region: "ANCASH" },
    { nombre: "AFOCAT LA UNICA", link: "https://www.afocat-launica.com/", region: "AREQUIPA" },
    { nombre: "AFOCAT FUTUIRA", link: "https://afocatfutuira.com/", region: "AREQUIPA" },
    { nombre: "AFOCAT RAVISUR", link: "https://www.ravisur.org.pe/", region: "AREQUIPA" },
    { nombre: "AFOCAT - REGION CAJAMARCA", link: "https://www.afocatregioncajamarca.net/index/", region: "CAJAMARCA" },
    { nombre: "AFOCATDC", link: "https://afocatdelcumbe.org/", region: "CAJAMARCA" },
    { nombre: "AFOCAT REGION CUSCO", link: "http://www.afocatregioncusco.pe/", region: "CUSCO" },
    { nombre: "AFOCAT LA SOLUCIÓN CUSCO", link: "https://afocatlasolucion.org.pe/", region: "CUSCO" },
    { nombre: "AFOCAT REGIONAL BELLA DURMIENTE", link: "https://www.afocatbelladurmiente.com/", region: "HUANUCO" },
    { nombre: "AFOCAT REGIONAL LEÓN DE HUÁNUCO", link: "https://afocat-regionalleondehuanuco.com/index.php", region: "HUANUCO" },
    { nombre: "AFOCAT ICA", link: "https://www.afocatregionica.org/", region: "ICA" },
    { nombre: "AFOCAT EL ANGEL", link: "http://www.afocatelangel.com", region: "ICA" },
    { nombre: "AFOCAT - JUNIN", link: "https://afocatjunin.com/", region: "JUNIN" },
    { nombre: "AFOCATU", link: "https://www.afocatu.pe/", region: "JUNIN" },
    { nombre: "AFOCAT R.J.P.H.", link: "https://afocatdelostransportistas.com/", region: "JUNIN" },
    { nombre: "AFOCAT REGIÓN CENTRO", link: "https://www.afocatregioncentro.pe/", region: "JUNIN" },
    { nombre: "AFOCAT - TRUJILLO - REGION LA LIBERTAD", link: "https://www.afocat-trujillo.com/", region: "LA LIBERTAD" },
    { nombre: "AFOCAT - LA LIBERTAD", link: "https://www.afocat.org.pe/", region: "LA LIBERTAD" },
    { nombre: "AFOCAT NUEVO HORIZONTE REGION LA LIBERTAD", link: "https://www.afocatnuevohorizonte.com/", region: "LA LIBERTAD" },
    { nombre: "FORCAT", link: "https://www.forcat-lambayeque.com/", region: "LAMBAYEQUE" },
    { nombre: "AFOCAT LÍDER PERÚ", link: "https://www.liderperuafocat.org/", region: "LIMA METROPOLITANA" },
    { nombre: "AFOCAT CONFIANZA", link: "https://afocatconfianza.org/", region: "LIMA METROPOLITANA" },
    { nombre: "AUTOSEGURO AFOCAT", link: "https://autoseguro.pe/", region: "LIMA METROPOLITANA" },
    { nombre: "AFOCAT LIMA METROPOLITANA", link: "http://www.afocatlimam.org/", region: "LIMA METROPOLITANA" },
    { nombre: "NUESTRA SEÑORA DE LA ASUNCION", link: "https://afocatsradelaasuncion.org.pe/", region: "LIMA PROVINCIAS" },
    { nombre: "AFOCAT DEL ORIENTE - REGION LORETO", link: "http://www.afocatdeloriente.org/login", region: "LORETO" },
    { nombre: "AFOCAT MOQUEGUA", link: "https://www.afocat-moquegua.com.pe/", region: "MOQUEGUA" },
    { nombre: "AFOCAT TRANS REGION PIURA", link: "https://www.afocattransregionpiura.com/", region: "PIURA" },
    { nombre: "AFOCAT - PIURA", link: "https://afocatpiura.com/", region: "PIURA" },
    { nombre: "AFOCAT LA PRIMERA", link: "https://afocatlaprimera.com/", region: "PUNO" },
    { nombre: "AFOCAT EL ALTIPLANO", link: "https://afocatelaltiplano.org/", region: "PUNO" },
    { nombre: "AFOCAT REGION SAN MARTIN", link: "https://www.afocat-sanmartin.com/", region: "SAN MARTIN" },
    { nombre: "AFOCAT - AFOSECAT - SAN MARTÍN", link: "https://www.afosecatsanmartin.com/", region: "SAN MARTIN" },
    { nombre: "AFOCAT SUR PERÚ REGIÓN TACNA", link: "https://afocatsurperu.com.pe/", region: "TACNA" },
    { nombre: "AFOCAT REGION TACNA", link: "https://www.afocattacna.com/", region: "TACNA" },
    { nombre: "FASMOT", link: "https://afocatfasmot.pe/", region: "TUMBES" },
    { nombre: "AFOCAT UCAYALINO REGIÓN UCAYALI", link: "https://afocat-regionalucayalino.com/", region: "UCAYALI" }
  ];

  // Populate region selector
  var regionSelector = document.getElementById('orv-region-selector');
  var afocatResults = document.getElementById('orv-afocat-results');
  if (regionSelector) {
    var regions = [];
    afocatData.forEach(function (item) {
      if (regions.indexOf(item.region) === -1) regions.push(item.region);
    });
    regions.sort().forEach(function (region) {
      var opt = document.createElement('option');
      opt.value = region;
      opt.textContent = region;
      regionSelector.appendChild(opt);
    });

    regionSelector.addEventListener('change', function (e) {
      var selected = e.target.value;
      afocatResults.innerHTML = '';
      afocatData.filter(function (i) { return i.region === selected; }).forEach(function (item) {
        var a = document.createElement('a');
        a.href = item.link;
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = 'orv-afocat-btn';
        a.innerHTML = '<span class="orv-afocat-name">' + item.nombre + '</span><i class="fas fa-external-link-alt"></i>';
        afocatResults.appendChild(a);
      });
      afocatResults.classList.remove('orv-hidden');
    });
  }

  // Smooth scroll for in-page anchors (#orv-*)
  document.querySelectorAll('.orv-wrap a[href^="#orv-"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var id = a.getAttribute('href').slice(1);
      var el = document.getElementById(id);
      if (el) {
        e.preventDefault();
        var top = el.getBoundingClientRect().top + window.pageYOffset - 90;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    });
  });

  // Contact form — post to Google Apps Script (same endpoint as original repo)
  var contactForm = document.getElementById('orv-contact-form');
  var formMessage = document.getElementById('orv-form-message');
  var submitBtn = document.getElementById('orv-submit-btn');
  var submitText = submitBtn ? submitBtn.querySelector('.orv-submit-text') : null;
  var submitIcon = submitBtn ? submitBtn.querySelector('i') : null;
  var submitLabel = submitText ? submitText.textContent : '';

  if (contactForm) {
    contactForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxCE9BYp031DtOacE9It6-cF6HYw6XbZ7MAovJ8Qura4a3bx_8Ou83Xf4Ar6HvdjRSh/exec";

      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = "{{t lang "orv.form.sending"}}";
      if (submitIcon) { submitIcon.className = 'fas fa-spinner fa-spin'; }

      var formData = new FormData(contactForm);

      fetch(SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(formData)
      })
      .then(function () {
        if (formMessage) {
          formMessage.textContent = "{{t lang "orv.form.success"}}";
          formMessage.classList.remove('orv-hidden', 'orv-msg-error');
          formMessage.classList.add('orv-msg-success');
        }
        contactForm.reset();
      })
      .catch(function () {
        if (formMessage) {
          formMessage.textContent = "{{t lang "orv.form.error"}}";
          formMessage.classList.remove('orv-hidden', 'orv-msg-success');
          formMessage.classList.add('orv-msg-error');
        }
      })
      .finally(function () {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = submitLabel;
        if (submitIcon) { submitIcon.className = 'fas fa-paper-plane'; }
        if (formMessage) {
          setTimeout(function () { formMessage.classList.add('orv-hidden'); }, 5000);
        }
      });
    });
  }

  // Floating bubble — hide when contacto section visible
  var bubble = document.getElementById('orv-bubble');
  var contacto = document.getElementById('orv-contacto');
  if (bubble && contacto && 'IntersectionObserver' in window) {
    // Show bubble after slight scroll
    function showBubble() { bubble.classList.add('orv-bubble-visible'); bubble.classList.remove('orv-hidden'); }
    function hideBubble() { bubble.classList.remove('orv-bubble-visible'); bubble.classList.add('orv-hidden'); }
    setTimeout(showBubble, 600);

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { hideBubble(); } else { /* keep current state */ }
      });
    }, { root: null, threshold: 0.1 });
    observer.observe(contacto);
  }
})();
</script>
