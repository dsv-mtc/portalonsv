<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --brand-red: #C8102E;
    --brand-red-dark: #9E0C24;
    --brand-navy: #14213D;
    --brand-navy-2: #1F3864;
    --brand-amber: #F4B41A;
    --brand-cyan: #1597B8;
    --brand-ink: #1b1e28;
    --brand-mist: #f1f4f9;
    --brand-line: #e3e7ef;
    --muted-foreground: #5c6273;
    --font-display: "Barlow Condensed", system-ui, sans-serif;
    --font-cond: "Barlow Semi Condensed", system-ui, sans-serif;
    --font-sans: "Barlow", system-ui, sans-serif;
  }

  .auth-wrap {
    min-height: 100vh;
    display: grid;
    background: #fff;
  }
  @media (min-width: 1024px) {
    .auth-wrap { grid-template-columns: 1.05fr 1fr; }
  }

  /* ── Left panel ── */
  .auth-hero {
    display: none;
    position: relative;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(160deg, #0d1730 0%, #14213D 55%, #1F3864 100%);
  }
  @media (min-width: 1024px) {
    .auth-hero { display: flex; }
  }

  .auth-hero .ribbon {
    position: absolute;
    inset: 0 0 auto 0;
    height: 32px;
    background: repeating-linear-gradient(45deg, #101a34, #101a34 14px, #16223f 14px, #16223f 28px);
  }
  .auth-hero .glow-amber {
    position: absolute;
    right: -96px;
    top: -96px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    opacity: .20;
    filter: blur(48px);
    background: radial-gradient(circle, #F4B41A 0%, transparent 60%);
  }
  .auth-hero .glow-red {
    position: absolute;
    left: -128px;
    bottom: 0;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    opacity: .30;
    filter: blur(48px);
    background: radial-gradient(circle, #C8102E 0%, transparent 55%);
  }

  .auth-hero .brand {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .auth-hero .brand .logo-wrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 3px #C8102E;
  }
  .auth-hero .brand .logo-wrap svg { width: 60%; height: 60%; }
  .auth-hero .brand .wordmark { line-height: 1; }
  .auth-hero .brand .wordmark .l1 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .auth-hero .brand .wordmark .l2 {
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--brand-amber);
    margin-top: 4px;
    display: block;
  }

  .auth-hero .content {
    position: relative;
    z-index: 10;
    max-width: 420px;
  }
  .auth-hero .badge {
    display: inline-block;
    padding: 4px 12px;
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    border-radius: 4px;
    background: var(--brand-red);
    color: #fff;
    margin-bottom: 24px;
  }
  .auth-hero .content h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 800;
    line-height: .98;
    text-transform: uppercase;
    color: #fff;
  }
  .auth-hero .content h1 em {
    font-style: normal;
    color: var(--brand-amber);
  }
  .auth-hero .content p {
    margin-top: 20px;
    font-size: 15px;
    color: rgba(255,255,255,.7);
    max-width: 360px;
    line-height: 1.5;
    font-family: var(--font-sans);
  }

  .auth-hero .stats {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .auth-hero .stats .card {
    position: relative;
    border-radius: 12px;
    padding: 12px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(4px);
  }
  .auth-hero .stats .card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 999px;
    background: var(--brand-amber);
  }
  .auth-hero .stats .card .num {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }
  .auth-hero .stats .card .label {
    font-family: var(--font-cond);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 4px;
    color: rgba(255,255,255,.6);
  }

  .auth-hero .footer {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,.5);
  }
  .auth-hero .footer svg {
    width: 16px;
    height: 16px;
    color: var(--brand-amber);
    fill: var(--brand-amber);
  }

  /* ── Right panel ── */
  .auth-form {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 24px;
  }
  .auth-form .inner {
    width: 100%;
    max-width: 420px;
  }

  .auth-form .mobile-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  @media (min-width: 1024px) {
    .auth-form .mobile-brand { display: none; }
  }
  .auth-form .mobile-brand .logo-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--brand-navy);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 3px #C8102E;
  }
  .auth-form .mobile-brand .logo-wrap svg { width: 60%; height: 60%; }
  .auth-form .mobile-brand .mb-l1 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--brand-navy);
    line-height: 1;
  }
  .auth-form .mobile-brand .mb-l2 {
    font-family: var(--font-cond);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--brand-red);
    line-height: 1;
    margin-top: 2px;
    display: block;
  }

  .auth-form .eyebrow {
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--brand-cyan);
  }
  .auth-form h2 {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    color: var(--brand-navy);
  }
  .auth-form .sub {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    line-height: 1.5;
  }

  .auth-form .flash {
    margin-top: 20px;
    padding: 12px 16px;
    border-radius: 10px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: var(--brand-red);
    font-size: 14px;
    font-family: var(--font-sans);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .auth-form .flash svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .auth-form form {
    margin-top: 32px;
  }
  .auth-form .field-group {
    margin-bottom: 20px;
  }

  /* ── Floating label ── */
  .floating-wrap {
    position: relative;
  }
  .floating-wrap input {
    width: 100%;
    height: 56px;
    border-radius: 12px;
    border: 2px solid var(--brand-line);
    background: #fff;
    padding: 20px 16px 4px;
    font-size: 15px;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color .2s;
  }
  .floating-wrap input:focus {
    border-color: var(--brand-navy);
  }
  .floating-wrap input.pw-field {
    padding-right: 44px;
  }
  .floating-wrap label {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    padding: 0 4px;
    background: #fff;
    font-family: var(--font-cond);
    font-size: 14px;
    color: var(--muted-foreground);
    transition: all .15s ease;
    pointer-events: none;
    line-height: 1;
  }
  .floating-wrap input:focus + label,
  .floating-wrap input:not(:placeholder-shown) + label {
    top: 10px;
    transform: translateY(0);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-navy);
  }
  .floating-wrap .pw-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--muted-foreground);
    transition: color .2s;
  }
  .floating-wrap .pw-toggle:hover {
    color: var(--brand-red);
  }
  .floating-wrap .pw-toggle svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .auth-form .options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    font-family: var(--font-sans);
    margin-top: 24px;
  }
  .auth-form .options label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
  }
  .auth-form .options label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--brand-red);
  }
  .auth-form .options .forgot {
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-red);
    cursor: default;
  }

  .auth-form .btn-submit {
    margin-top: 24px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    border: none;
    border-radius: 12px;
    background: var(--brand-red);
    color: #fff;
    font-family: var(--font-cond);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background .2s, box-shadow .2s;
    box-shadow: 0 10px 28px -10px rgba(200,16,46,.6);
  }
  .auth-form .btn-submit:hover {
    background: var(--brand-red-dark);
  }
  .auth-form .btn-submit svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .auth-form .btn-submit .arrow {
    transition: transform .15s;
  }
  .auth-form .btn-submit:hover .arrow {
    transform: translateX(2px);
  }

  .auth-form .mtc {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--brand-line);
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted-foreground);
  }
  .auth-form .mtc .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-red);
    flex-shrink: 0;
  }

  /* Oculta ojito nativo del navegador (Chrome, Edge, IE) */
  input[type="password"]::-ms-reveal,
  input[type="password"]::-ms-clear {
    display: none;
  }
  input[type="password"]::-webkit-credentials-auto-fill-button {
    display: none !important;
  }
</style>

<div class="auth-wrap">
  <div class="auth-hero">
    <div class="ribbon"></div>
    <div class="glow-amber"></div>
    <div class="glow-red"></div>

    <div class="brand">
      <div class="logo-wrap" style="background: #fff; box-shadow: inset 0 0 0 3px #C8102E;">
        <img src="/img/logo-1.svg" alt="ONSV" style="width: 60%; height: 60%; object-fit: contain;">
      </div>
      <div class="wordmark">
        <div class="l1">Observatorio Nacional</div>
        <span class="l2">de Seguridad Vial · MTC</span>
      </div>
    </div>

    <div class="content">
      <span class="badge">Panel Administrativo</span>
      <h1>Bienvenido de nuevo, <em>administrador</em>.</h1>
      <p>Gestiona cifras, regiones, comunicaciones, analítica y datos abiertos del Portal ONSV desde un solo lugar.</p>
      <div class="stats">
        <div class="card"><div class="num">24</div><div class="label">Cifras</div></div>
        <div class="card"><div class="num">148</div><div class="label">Datasets</div></div>
        <div class="card"><div class="num">36</div><div class="label">Eventos</div></div>
      </div>
    </div>

    <div class="footer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Conexión cifrada · Acceso restringido
    </div>
  </div>

  <div class="auth-form">
    <div class="inner">
      <div class="mobile-brand">
        <div class="logo-wrap" style="background: #14213D; box-shadow: inset 0 0 0 3px #C8102E;">
          <img src="/img/logo-1.svg" alt="ONSV" style="width: 60%; height: 60%; object-fit: contain;">
        </div>
        <div>
          <div class="mb-l1">Portal ONSV</div>
          <span class="mb-l2">Panel administrativo</span>
        </div>
      </div>

      <div class="eyebrow">Autenticación</div>
      <h2>Iniciar sesión</h2>
      <p class="sub">Ingresa tus credenciales institucionales para acceder al panel.</p>

      {{#if info_login}}
        <div class="flash">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {{info_login}}
        </div>
      {{/if}}

      <form action="/administrador/login" method="POST">
        <div class="field-group floating-wrap">
          <input type="email" id="email" name="email" placeholder=" " required />
          <label for="email">Correo institucional</label>
        </div>

        <div class="field-group floating-wrap">
          <input type="password" id="password" name="password" placeholder=" " class="pw-field" required />
          <label for="password">Contraseña</label>
          <button type="button" class="pw-toggle" id="pwToggle" aria-label="Mostrar u ocultar contraseña">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="pwIcon"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>

        <div class="options">
          <label>
            <input type="checkbox" />
            Mantener sesión iniciada
          </label>
          <span class="forgot">¿Olvidaste tu contraseña?</span>
        </div>

        <button type="submit" class="btn-submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Ingresar al panel
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </form>

      <div class="mtc">
        <span class="dot"></span>
        Ministerio de Transportes y Comunicaciones
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var toggle = document.getElementById("pwToggle");
    var pw = document.getElementById("password");
    var icon = document.getElementById("pwIcon");
    if (toggle && pw && icon) {
      toggle.addEventListener("click", function () {
        var isPassword = pw.type === "password";
        pw.type = isPassword ? "text" : "password";
        icon.innerHTML = isPassword
          ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
          : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
      });
    }
  });
</script>