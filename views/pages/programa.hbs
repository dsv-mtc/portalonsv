<div class="container mt-5 wbn-page programa-page">
	<div class="wbn-tab-row">
		<span class="wbn-tab">PROGRAMAS</span>
	</div>

	<div class="row wbn-row programa-card fx-hide">
		<div class="col-12 col-md-6 pt-4 mb-3">
			<div class="wbn-thumb-wrap programa-thumb-wrap">
				{{#if imagen}}
					<img src="{{imagen}}" alt="{{titulo}}" style="width:100%;height:260px;object-fit:contain;display:block;background:#f8fafc;">
				{{else}}
					<div style="min-height:260px;background:linear-gradient(135deg,#2E5C99,#14213D);"></div>
				{{/if}}
			</div>
		</div>
		<div class="col-12 col-md-6 my-auto">
			<h2 class="mb-2 wbn-title">{{titulo}}</h2>
			<p class="text-justify mb-3 wbn-desc">{{descripcion}}</p>
			{{#if enlace}}
				<a href="{{enlace}}" target="_blank" rel="noopener noreferrer" class="wbn-yt">Visitar enlace web</a>
			{{/if}}
		</div>
	</div>
</div>
