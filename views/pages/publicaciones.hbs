<link rel="stylesheet" href="/css/publicaciones.css">

<script src="/js/publicaciones.js"></script>

<section class="publicaciones-section">

	<div>
		<div class="pub-title">
			<h1>{{t lang "Publicaciones"}}</h1>
		</div>

		<div class="filters pub-filterbox">

			<form id="searchForm" method="GET">

				<div class="input-group mb-4">
					<input type="text" id="title" name="title"
					       class="form-control main-search"
					       placeholder="{{t lang "buscar"}}"
					       {{#if title}}
					       	value="{{title}}"
					       {{/if}}>

					<div class="input-group-append">
						<button class="input-group-text search-input" type="submit">
							<i class="fal fa-search"></i>
						</button>
					</div>
				</div>

				<div class="pub-field">
					<label for="categoria">{{t lang "Categoria"}}</label>
					<select name="categoria" id="categoria" class="form-control">
						<option {{#if categoria}} {{else}} selected {{/if}} value=''>{{t lang "Seleccionar categoría"}}</option>
						{{#each allTags}}
							<option value="{{this.slug}}" {{#if this.estaSeleccionado}} selected {{/if}}>{{this.name}}</option>
						{{/each}}
					</select>
				</div>

				<div class="pub-field">
					<label for="region">{{t lang "Región"}}</label>
					<select name="region" id="region" class="form-control">
						<option {{#if region}} {{else}} selected {{/if}} value=''>{{t lang "Seleccionar región"}}</option>
						{{#each regiones}}
							<option value="{{this.slug}}" {{#if this.estaSeleccionado}} selected {{/if}}>{{this.value}}</option>
						{{/each}}
					</select>
				</div>

				<div class="pub-field">
					<label for="year">{{t lang "Año"}}</label>
					<select name="year" id="year" class="form-control">
						<option {{#if year}} {{else}} selected {{/if}} value=''>{{t lang "Seleccionar año"}}</option>
						{{#each years}}
							<option value="{{this.slug}}" {{#if this.estaSeleccionado}} selected {{/if}}>{{this.name}}</option>
						{{/each}}
					</select>
				</div>

				<div class="pub-fbtns">
					<button class="pub-btn-buscar" type="submit">
						{{t lang "Buscar"}}
					</button>
					<button class="pub-btn-limpiar" id="clearButton">
						{{t lang "Limpiar"}}
					</button>
				</div>

			</form>

			{{>sidebar-widgets/subscribers lang=lang}}

		</div>

	</div>

	<div class="results">
		{{#if hasResults}}
			{{#each posts}}
				{{>publicaciones/publicaciones-card-body lang=../lang}}
			{{/each}}

			{{#if pagination}}
        <style>
        .custom-pag-wrapper {
          gap: 8px;
        }
        .custom-pag-btn {
          width: 42px;
          height: 42px;
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: bold;
          font-size: 17px;
          border: 1px solid transparent;
          background: transparent;
          color: #1d3557;
          transition: all 0.3s ease;
          text-decoration: none;
          cursor: pointer;
        }
        .custom-pag-btn:hover {
          background-color: transparent;
          color: #C8102E;
          border: 1px solid #C8102E;
        }
        .custom-pag-btn.active {
          background-color: #C8102E;
          color: white;
          box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .custom-pag-btn.active:hover {
          background-color: #C8102E;
          color: white;
          border: 1px solid transparent;
        }
        .custom-pag-btn i {
          font-size: 20px;
        }
      </style>

        <nav class="col-12 d-flex justify-content-center align-items-center mt-5 mb-4 custom-pag-wrapper">
          {{#each (range 1 pagination.pages)}}
            <a href="{{page_url ../pagination.url_page this ../lang}}" class="custom-pag-btn{{#if (eq this ../pagination.page)}} active{{/if}}" aria-label="Página {{this}}">{{this}}</a>
          {{/each}}
          {{#if pagination.next}}
            <a href="{{page_url pagination.url_page pagination.next lang}}" class="custom-pag-btn" aria-label="Siguiente página">
              <i class="fal fa-chevron-right"></i>
            </a>
          {{/if}}
          <a href="{{page_url pagination.url_page pagination.pages lang}}" class="custom-pag-btn" aria-label="Última página">
            <i class="fal fa-chevron-double-right"></i>
          </a>
        </nav>
        {{/if}}
		{{else}}
			<h3 style="margin: .75em 0 1.25em; font-size:1.25em; font-weight:bold!important;">
				{{t lang "No se encontraron resultados"}}
			</h3>
		{{/if}}
	</div>

</section>