<section class="rsp-navbar banner-admin">
  <div class="d-flex justify-content-between align-items-center px-4 w-100">
    <div class="logo-admin">
      <a class="navbar-brand" href="{{endpointRebase settings.url}}">
        <img class="logo-img-admin" src="/img/logo-datos.png" alt="{{ settings.title }}">
      </a>
    </div>
    <div class="logout-wrapper">
      <a href="/administrador/logout" class="btn-logout-admin">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        {{#if secondary_navigation}}Logout{{else}}Cerrar sesión{{/if}}
      </a>
    </div>
  </div>
</section>

{{>admin/navigation secondary_navigation=secondary_navigation}}

<main class="container-fluid admin-main-content py-5">
  <div class="container" style="max-width: 900px;">
    
    <div class="admin-card">
      <h3 class="admin-title mb-4 text-center">
        Actualizar pie de página
      </h3>
      
      {{#if info_document}}
        {{#each info_document}}
          <div class="alert {{style}} alert-dismissible fade show admin-alert" role="alert">
            <strong>{{message}}</strong> 
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        {{/each}}
      {{/if}}

      <form id="datosabiertos-form" action="/administrador/footer" method="POST" class="needs-validation mt-4" novalidate>
        
        <div class="form-group row align-items-center mb-4">
          <label for="telefono" class="col-12 col-md-3 col-form-label admin-label">
            * Número de teléfono:
          </label>
          <div class="col-12 col-md-9">
            <input type="text" id="telefono" name="telefono" maxlength="200" placeholder="Ingrese el número de teléfono" class="form-control admin-input" required pattern="[0-9\+\-\ ]*" value="{{telefono}}">
            <small class="invalid-feedback">
              {{#if secondary_navigation}}You must enter a valid phone number (9 digits).{{else}}Debe introducir un número de teléfono válido (9 dígitos).{{/if}}
            </small>
          </div>
        </div>

        <div class="form-group row align-items-center mb-4">
          <label for="direccion" class="col-12 col-md-3 col-form-label admin-label">
            * Dirección:
          </label>
          <div class="col-12 col-md-9">
            <input type="text" id="direccion" name="direccion" maxlength="200" placeholder="Ingresa la dirección" class="form-control admin-input" required value="{{direccion}}">
          </div>
        </div>

        <div class="form-group row align-items-center mb-4">
          <label for="email" class="col-12 col-md-3 col-form-label admin-label">
            * Correo:
          </label>
          <div class="col-12 col-md-9">
            <input type="text" id="email" name="email" maxlength="200" placeholder="Ingrese el email" class="form-control admin-input" required pattern="^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)$" value="{{email}}">
            <small class="invalid-feedback">
              Debe introducir un correo válido.
            </small>
          </div>
        </div>

        <div class="form-group row align-items-center mb-4">
          <label for="piePagina" class="col-12 col-md-3 col-form-label admin-label">
            * Pie página:
          </label>
          <div class="col-12 col-md-9">
            <input type="text" id="piePagina" name="piePagina" maxlength="200" placeholder="Ingrese el pie de página" class="form-control admin-input" required value="{{piePagina}}">
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-5 pt-3" style="border-top: 1px solid #e2e8f0;">
          <p class="admin-required-note m-0">
            * {{#if secondary_navigation}}Required fields{{else}}Campos obligatorios{{/if}}
          </p>
          
          <button type="submit" class="btn btn-admin-primary">
            {{#if secondary_navigation}}Send{{else}}Enviar Información{{/if}}
          </button>
        </div>
        
      </form>
    </div>
    
  </div>
</main>