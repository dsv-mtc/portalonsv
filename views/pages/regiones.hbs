<section class="rsp-cont-tab-section rsp-wrap">
	<div class="container">
		<div class="regiones-tab-row">
			<span class="regiones-tab">{{t lang "Consejos Regionales de Seguridad Vial"}}</span>
		</div>
		<div class="row">

			<!--Map svg-->
			<div class="col-12 col-lg-6 d-none d-sm-block">
				<div class="crsv-card crsv-map-card">
					<div class="crsv-map-toolbar">
						<select name="select-region" id="select-region" class="custom-select">
							<option value="Lima">Lima</option>
							<option value="Amazonas">Amazonas</option>
							<option value="Ancash">Ancash</option>
							<option value="Apurímac">Apurímac</option>
							<option value="Arequipa">Arequipa</option>
							<option value="Ayacucho">Ayacucho</option>
							<option value="Cajamarca">Cajamarca</option>
							<option value="Callao">Callao</option>
							<option value="Cusco">Cusco</option>
							<option value="Huancavelica">Huancavelica</option>
							<option value="Huanuco" data-map="Huánuco">Huánuco</option>
							<option value="Ica">Ica</option>
							<option value="Junin" data-map="Junín">Junín</option>
							<option value="La Libertad">La Libertad</option>
							<option value="Lambayeque">Lambayeque</option>
							<option value="Loreto">Loreto</option>
							<option value="Madre de Dios">Madre De Dios</option>
							<option value="Moquegua">Moquegua</option>
							<option value="Pasco">Pasco</option>
							<option value="Piura">Piura</option>
							<option value="Puno">Puno</option>
							<option value="San Martín">San Martín</option>
							<option value="Tacna">Tacna</option>
							<option value="Tumbes">Tumbes</option>
							<option value="Ucayali">Ucayali</option>
						</select>
					</div>
					<div class="vu-map">
						<div class="mapouter">
							<div class="gmap_canvas" style="position: relative;">
								{{>regiones/map}}
								<div id="region-label" class="region-label" style="display: none;"></div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-6">
				<div class="rsp-c-tab-blk crsv-card">

					<div class="crsv-head">
						<div class="crumb">{{t lang "Perú"}} <span class="sep">›</span> {{t lang "Departamento"}}</div>
						<h3 class="rsp-title ft-bold crsv-title">
							{{t lang "Consejo Regional de Seguridad Vial"}}
						</h3>
						<span
							style="display: block; text-align: left; color: white; margin-left: 2px; font-weight: bold; font-size: 2rem;"
							id="region-name"
							class="crsv-region"
						></span>
					</div>

					<div class="crsv-body">

						<div class="rsp-ct-us-img crsv-logo" id="img-region">
							<img src="/img/usre-icon.png" alt="user">
						</div>

						<div class="rfield">
							<span class="ic"><i class="fas fa-user"></i></span>
							<div>
								<span class="k">{{t lang "Nombre"}}</span>
								<span class="v form-control" id="nombre">{{t lang "Nombre"}}</span>
							</div>
						</div>

						<div class="rfield">
							<span class="ic"><i class="fas fa-phone"></i></span>
							<div>
								<span class="k">{{t lang "Telefono"}}</span>
								<span class="v form-control" id="telefono">{{t lang "Telefono"}}</span>
							</div>
						</div>

						<div class="rfield">
							<span class="ic"><i class="fas fa-envelope"></i></span>
							<div>
								<span class="k">{{t lang "Correo"}}</span>
								<span class="v form-control" id="email">{{t lang "Correo"}}</span>
							</div>
						</div>

						<div class="rfield">
							<span class="ic"><i class="fas fa-globe"></i></span>
							<div>
								<span class="k">{{t lang "Sitio web"}}</span>
								<a class="v form-control" id="pageLink" target="_blank">{{t lang "Sitio web"}}</a>
							</div>
						</div>

					</div>
				</div>
			</div>

</div>
	</div>
</section>

<script>
function updateRegionName(regionId){
    const regionNameElement = document.getElementById('region-name');
    if(regionNameElement){
        regionNameElement.textContent = regionId;
    }
    
    const breadcrumbElement = document.querySelector('.crumb');
    if(breadcrumbElement){
        breadcrumbElement.innerHTML = (location.href.includes('/en/') ? 'Peru' : 'Perú') + ' <span class="sep">›</span> ' + regionId;
    }
}

function showRegionLabel(regionId){
    const label = document.getElementById('region-label');
    const pathElement = document.getElementById(regionId);
    
    if(label && pathElement){
        const svgContainer = document.querySelector('.gmap_canvas');
        const svgRect = svgContainer.getBoundingClientRect();
        const pathRect = pathElement.getBoundingClientRect();
        
        label.textContent = regionId;
        label.style.display = 'block';
        label.style.left = (pathRect.left - svgRect.left + pathRect.width / 2) + 'px';
        label.style.top = (pathRect.top - svgRect.top + pathRect.height / 2) + 'px';
    }
}

// Listener para el select de departamentos
const selectRegion = document.getElementById('select-region');
if(selectRegion){
    selectRegion.addEventListener('change', function(e){
        const opt = e.target.options[e.target.selectedIndex];
        const pathId = opt.getAttribute('data-map') || opt.value;
        const pathElement = document.getElementById(pathId);
        if(pathElement){
            setTimeout(()=>{
                updateRegionName(opt.value);
                showRegionLabel(pathId);
            }, 50);
        }
    });
}

// Usar delegación de eventos en el contenedor del mapa
document.querySelector('.gmap_canvas').addEventListener('click', function(e){
    if(e.target.tagName === 'path' && e.target.id){
        const opt = selectRegion.querySelector('option[value="' + e.target.id + '"], option[data-map="' + e.target.id + '"]');
        if (opt) {
            selectRegion.value = opt.value;
            selectRegion.dispatchEvent(new Event('change'));
        }
    }
});

// Inicializar con Lima al cargar
window.addEventListener('load', function(){
    if(location.href.includes('regiones')){
        setTimeout(()=>{
            updateRegionName('Lima');
            const limaPath = document.getElementById('Lima');
            if(limaPath){
                showRegionLabel('Lima');
            }
        }, 300);
    }
});
</script>

<!--Sección de noticias de regiones-->
<section class="rsp-noti-sec rsp-wrap">
	<div class="container">
		<div class="row">
			<div class="col-md-12 mb-4">
				<h3 class="rsp-title ft-bold">
					{{t lang "not_reg"}}
				</h3>
			</div>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="owl-carousel owl-theme" id="noti">
					{{>regiones/carousel-regions lang=lang post=post}}
				</div>
			</div>
		</div>
	</div>
</section>