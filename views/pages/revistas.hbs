<link rel="stylesheet" href="/css/publicaciones.css">
<script src="/js/revistas.js"></script>

<section class="publicaciones-section revistas-section">

	<div>
		<div class="pub-title">
			<h1>Revistas</h1>
		</div>

		<div class="filters pub-filterbox">

			<form id="searchForm" method="GET">

				<div class="input-group mb-4">
					<input type="text" id="title" name="title"
					       class="form-control main-search"
					       placeholder="{{t lang "buscar"}}"
					       {{#if title}}
					       	value="{{title}}"
					       {{/if}}>

					<div class="input-group-append">
						<button class="input-group-text search-input" type="submit">
							<i class="fal fa-search"></i>
						</button>
					</div>
				</div>

				<div class="pub-field">
					<label for="tema">Tema</label>
					<select name="tema" id="tema" class="form-control">
						<option {{#if tema}} {{else}} selected {{/if}} value=''>Todos</option>
						{{#each temas}}
							<option value="{{this.slug}}" {{#if this.estaSeleccionado}} selected {{/if}}>{{this.name}}</option>
						{{/each}}
					</select>
				</div>

				<div class="pub-fbtns">
					<button class="pub-btn-buscar" type="submit">
						Buscar
					</button>
					<button class="pub-btn-limpiar" id="clearButton">
						Limpiar
					</button>
				</div>

			</form>

			{{>sidebar-widgets/subscribers lang=lang}}

		</div>

	</div>

	<div class="results">
		{{#if hasResults}}
			{{#each revistas}}
				{{>revistas/revistas-card-body lang=../lang}}
			{{/each}}

		  <style>
        .custom-pag-wrapper {
          gap: 8px;
        }
        .custom-pag-btn {
          width: 42px;
          height: 42px;
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: bold;
          font-size: 17px;
          border: 1px solid transparent;
          background: transparent;
          color: #1d3557;
          transition: all 0.3s ease;
          text-decoration: none;
          cursor: pointer;
        }
        .custom-pag-btn:hover {
          background-color: transparent;
          color: #C8102E;
          border: 1px solid #C8102E;
        }
        .custom-pag-btn.active {
          background-color: #C8102E;
          color: white;
          box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .custom-pag-btn.active:hover {
          background-color: #C8102E;
          color: white;
          border: 1px solid transparent;
        }
        .custom-pag-btn i {
          font-size: 20px;
        }
      </style>

        <nav class="col-12 d-flex justify-content-center align-items-center mt-5 mb-4 custom-pag-wrapper">
          <a href="#" class="custom-pag-btn active" aria-label="Página 1">1</a>
          <a href="#" class="custom-pag-btn" aria-label="Página 2">2</a>
          <a href="#" class="custom-pag-btn" aria-label="Página 3">3</a>
          <a href="#" class="custom-pag-btn" aria-label="Página 4">4</a>
          <a href="#" class="custom-pag-btn" aria-label="Siguiente página">
            <i class="fal fa-chevron-right"></i>
          </a>
          <a href="#" class="custom-pag-btn" aria-label="Última página">
            <i class="fal fa-chevron-double-right"></i>
          </a>
        </nav>
		{{else}}
			<h3 style="margin: .75em 0 1.25em; font-size:1.25em; font-weight:bold!important;">
				No se encontraron resultados
			</h3>
		{{/if}}
	</div>

</section>