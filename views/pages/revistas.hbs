<link rel="stylesheet" href="/css/publicaciones.css">
<script src="/js/revistas.js"></script>

<section class="publicaciones-section revistas-section">

	<div>
		<div class="pub-title">
			<h1>{{t lang "Revistas"}}</h1>
		</div>

		<div class="filters pub-filterbox">

			<form id="searchForm" method="GET">

				<div class="input-group mb-4">
					<input type="text" id="title" name="title"
					       class="form-control main-search"
					       placeholder="{{t lang "buscar"}}"
					       {{#if title}}
					       	value="{{title}}"
					       {{/if}}>

					<div class="input-group-append">
						<button class="input-group-text search-input" type="submit">
							<i class="fal fa-search"></i>
						</button>
					</div>
				</div>

				<div class="pub-field">
					<label for="tema">{{t lang "Tema"}}</label>
					<select name="tema" id="tema" class="form-control">
						<option {{#if tema}} {{else}} selected {{/if}} value=''>{{t lang "Todos"}}</option>
						{{#each temas}}
							<option value="{{this.slug}}" {{#if this.estaSeleccionado}} selected {{/if}}>{{this.name}}</option>
						{{/each}}
					</select>
				</div>

				<div class="pub-fbtns">
					<button class="pub-btn-buscar" type="submit">
						{{t lang "Buscar"}}
					</button>
					<button class="pub-btn-limpiar" id="clearButton">
						{{t lang "Limpiar"}}
					</button>
				</div>

			</form>

			{{>sidebar-widgets/subscribers lang=lang}}

		</div>

	</div>

	<div class="results">
		{{#if hasResults}}
			{{#each revistas}}
				{{>revistas/revistas-card-body lang=../lang}}
			{{/each}}

		{{else}}
			<h3 style="margin: .75em 0 1.25em; font-size:1.25em; font-weight:bold!important;">
				{{t lang "No se encontraron resultados"}}
			</h3>
		{{/if}}
	</div>

</section>