<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.1/index.global.min.js"></script>
<link rel="stylesheet" href="/css/comunicaciones/eventos.css">
<script src="/js/comunicaciones/eventos.js"></script>

<section class="events-section container wrap" style="padding: 40px 0;">
  
  <div class="events-header">
    <div class="events-main-title">
      <h1>CAMPAÑAS, EVENTOS Y ENTREVISTAS</h1>
    </div>
    
    <div class="events-filter">
      <div class="filter-buttons" data-all-eventos="{{all}}" data-all-near-eventos="{{allNear}}">
        <button class="ny-btn btn-filter all-button active" data-filter="todos">TODAS</button>
        <button class="ny-btn btn-filter campaign-button" data-filter="campanias">CAMPAÑAS</button>
        <button class="ny-btn btn-filter event-button" data-filter="eventos">EVENTOS</button>
        <button class="ny-btn btn-filter interview-button" data-filter="entrevistas">ENTREVISTAS</button>
      </div>
    </div>
  </div>
  
  <div class="events-grid">
    
    <div class="calendar-wrapper">
      <div class="calendar" id="calendar" data-filtered-eventos="{{eventos}}"></div>
    </div>

    <div class="sidebar-wrapper">
      <div class="events-sidebar">
        <h3 class="sidebar-title">PRÓXIMOS EVENTOS</h3>
        
        <div class="results">
          {{#each eventosProximos}}
            {{> comunicaciones/evento-card}}
          {{/each}}
        </div>
      </div>
    </div>

  </div>

</section>