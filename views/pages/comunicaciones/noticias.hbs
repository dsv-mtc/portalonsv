<section class="rsp-nye-section rsp-wrap">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <div class="noticias-tab-row">
          <span class="noticias-tab">{{t lang "Noticias"}}</span>
        </div>
      </div>
      <div class="col-md-5 ml-auto">
        <div class="input-group">
          <input type="text" id="search-input" class="form-control main-search" placeholder="{{t lang "buscar"}}" >
          <div class="input-group-append">
            <span id="search-button" class="input-group-text search-input">
              <i class="fal fa-search"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
    <div id="search-alert" class="alert alert-danger alert-dismissible fade hide" role="alert">
      {{t lang "no-results"}}
    </div>
    <div class="row" id="default">
      {{#each post}}
        {{#if @first}}
          {{> noticias-eventos/noticias-eventos-card-head lang=../lang}}
          {{else}}
            {{> noticias-eventos/noticias-eventos-card-body lang=../lang}}
        {{/if}}
      {{/each}}
<style>
        .custom-pag-wrapper {
          gap: 8px;
        }
        .custom-pag-btn {
          width: 42px;
          height: 42px;
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: bold;
          font-size: 17px;
          border: 1px solid transparent;
          background: transparent;
          color: #1d3557;
          transition: all 0.3s ease;
          text-decoration: none;
          cursor: pointer;
        }
        .custom-pag-btn:hover {
          background-color: transparent;
          color: #C8102E;
          border: 1px solid #C8102E;
        }
        .custom-pag-btn.active {
          background-color: #C8102E;
          color: white;
          box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .custom-pag-btn.active:hover {
          background-color: #C8102E;
          color: white;
          border: 1px solid transparent;
        }
        .custom-pag-btn i {
          font-size: 20px;
        }

        .pd-desc .cl {
          font-family: "Barlow Semi Condensed", sans-serif;
          font-weight: bold;
          font-size: 12px;
          text-transform: uppercase;
          letter-spacing: 0.05em;
        }

      </style>

      <div class="col-12 d-flex justify-content-center align-items-center mt-5 mb-4 custom-pag-wrapper">
        {{#if pagination}}
          {{#each (range 1 pagination.pages)}}
            <a href="{{page_url ../pagination.url_page this ../lang}}" class="custom-pag-btn{{#if (eq this ../pagination.page)}} active{{/if}}" aria-label="Página {{this}}">{{this}}</a>
          {{/each}}
          {{#if pagination.next}}
            <a href="{{page_url pagination.url_page pagination.next lang}}" class="custom-pag-btn" aria-label="Siguiente página">
              <i class="fal fa-chevron-right"></i>
            </a>
          {{/if}}
          <a href="{{page_url pagination.url_page pagination.pages lang}}" class="custom-pag-btn" aria-label="Última página">
            <i class="fal fa-chevron-double-right"></i>
          </a>
        {{/if}}
      </div>  
    </div>
    <div class="row" id="results-template">
      
    </div>                
  </div>
</section>